# RV64 Compliance Test Runner
# Runs rv64ui and rv64um tests against riscv64xO3 RV64IMAC

# Toolchain (override with RISCV_PREFIX=riscv64-unknown-elf- etc.)
ifeq ($(origin RISCV_PREFIX), undefined)
  ifneq ($(shell command -v riscv64-unknown-elf-gcc 2>/dev/null),)
    RISCV_PREFIX = riscv64-unknown-elf-
  else
    RISCV_PREFIX = riscv-none-elf-
  endif
endif
OBJCOPY = $(RISCV_PREFIX)objcopy
NM = $(RISCV_PREFIX)nm

# Test Locations
RISCV_TESTS_DIR = ../riscv-tests/isa

BUILD_DIR = build
SIM = ../../build/obj_dir/rv64xo3_sim

# RV64UI test list (54 tests)
RV64UI_TESTS = \
	add addi addiw addw \
	and andi auipc \
	beq bge bgeu blt bltu bne \
	fence_i \
	jal jalr \
	lb lbu ld lh lhu lw lwu \
	lui \
	ma_data \
	or ori \
	sb sd sh simple sll slli slliw sllw \
	slt slti sltiu sltu \
	sra srai sraiw sraw \
	srl srli srliw srlw \
	st_ld ld_st \
	sub subw sw \
	xor xori

# RV64UM test list
RV64UM_TESTS = \
	mul mulh mulhsu mulhu \
	div divu rem remu \
	mulw divw divuw remw remuw

# RV64MI test list (privileged + trap behavior; only existing binaries)
# Note: pmpaddr excluded (no PMP unit yet); misaligned trap tests exercise
# the MEM trap path with mtval/mepc checks.
RV64MI_TESTS = \
	breakpoint csr \
	illegal mcsr scall \
	zicntr sbreak \
	ld-misaligned lh-misaligned lw-misaligned \
	sd-misaligned sh-misaligned sw-misaligned \
	ma_addr ma_fetch

.PHONY: all run clean rv64ui rv64um rv64mi check-env

all: run

check-env:
	@if [ ! -x $(SIM) ]; then echo "Simulator not found at $(SIM). Build it first:"; echo "  make sim   (from repo root)"; exit 1; fi
	@if ! command -v $(OBJCOPY) >/dev/null 2>&1; then echo "RISC-V toolchain not found ($(OBJCOPY))."; echo "Install riscv64-unknown-elf-gcc, or use the dev container:"; echo "  make docker-shell"; exit 1; fi
	@if [ ! -f $(RISCV_TESTS_DIR)/rv64ui-p-add ]; then echo "riscv-tests binaries not found in $(RISCV_TESTS_DIR)."; echo "Fetch and build them:"; echo "  git submodule update --init tb/riscv-tests"; echo "  cd tb/riscv-tests && ./configure --prefix=\$$RISCV && make -j"; echo "(needs riscv64-unknown-elf-gcc in PATH; see riscv-tests README)"; exit 1; fi

$(BUILD_DIR):
	mkdir -p $(BUILD_DIR)

# Run all RV64 tests
run: check-env rv64ui rv64um rv64mi
	@echo ""
	@echo "=== RV64 Compliance Done (per-suite results above) ==="

# RV64UI tests
rv64ui: $(BUILD_DIR)
	@echo "Running RV64UI tests from $(RISCV_TESTS_DIR)..."
	@passed=0; failed=0; skipped=0; \
	for test in $(RV64UI_TESTS); do \
		TEST_SRC=$(RISCV_TESTS_DIR)/rv64ui-p-$$test; \
		if [ -f $$TEST_SRC ]; then \
			echo -n "  $$test: "; \
			$(OBJCOPY) -O binary $$TEST_SRC $(BUILD_DIR)/rv64ui-p-$$test.bin 2>/dev/null || exit 1; \
			TOHOST=$$( $(NM) $$TEST_SRC 2>/dev/null | awk '$$3 == "tohost" { print "0x" $$1 }' ); \
			test -n "$$TOHOST" || exit 1; \
			if $(SIM) $(BUILD_DIR)/rv64ui-p-$$test.bin --timeout 2000000 --tohost $$TOHOST > $(BUILD_DIR)/rv64ui-p-$$test.log 2>&1; then \
				echo "PASS"; \
				passed=$$((passed + 1)); \
			else \
				echo "FAIL"; \
				failed=$$((failed + 1)); \
			fi; \
		else \
			echo "  $$test: SKIP (not found)"; \
			skipped=$$((skipped + 1)); \
		fi; \
	done; \
	echo ""; \
	echo "RV64UI Results: $$passed passed, $$failed failed, $$skipped skipped"; \
	test $$failed -eq 0 && test $$skipped -eq 0

# RV64MI tests
rv64mi: $(BUILD_DIR)
	@echo "Running RV64MI tests from $(RISCV_TESTS_DIR)..."
	@passed=0; failed=0; skipped=0; \
	for test in $(RV64MI_TESTS); do \
		TEST_SRC=$(RISCV_TESTS_DIR)/rv64mi-p-$$test; \
		if [ -f $$TEST_SRC ]; then \
			echo -n "  $$test: "; \
			$(OBJCOPY) -O binary $$TEST_SRC $(BUILD_DIR)/rv64mi-p-$$test.bin 2>/dev/null || exit 1; \
			TOHOST=$$( $(NM) $$TEST_SRC 2>/dev/null | awk '$$3 == "tohost" { print "0x" $$1 }' ); \
			test -n "$$TOHOST" || exit 1; \
			if $(SIM) $(BUILD_DIR)/rv64mi-p-$$test.bin --timeout 2000000 --tohost $$TOHOST > $(BUILD_DIR)/rv64mi-p-$$test.log 2>&1; then \
				echo "PASS"; \
				passed=$$((passed + 1)); \
			else \
				echo "FAIL"; \
				failed=$$((failed + 1)); \
			fi; \
		else \
			echo "  $$test: SKIP (not found)"; \
			skipped=$$((skipped + 1)); \
		fi; \
	done; \
	echo ""; \
	echo "RV64MI Results: $$passed passed, $$failed failed, $$skipped skipped"; \
	test $$failed -eq 0 && test $$skipped -eq 0

# RV64UM tests
rv64um: $(BUILD_DIR)
	@echo "Running RV64UM tests from $(RISCV_TESTS_DIR)..."
	@passed=0; failed=0; skipped=0; \
	for test in $(RV64UM_TESTS); do \
		TEST_SRC=$(RISCV_TESTS_DIR)/rv64um-p-$$test; \
		if [ -f $$TEST_SRC ]; then \
			echo -n "  $$test: "; \
			$(OBJCOPY) -O binary $$TEST_SRC $(BUILD_DIR)/rv64um-p-$$test.bin 2>/dev/null || exit 1; \
			TOHOST=$$( $(NM) $$TEST_SRC 2>/dev/null | awk '$$3 == "tohost" { print "0x" $$1 }' ); \
			test -n "$$TOHOST" || exit 1; \
			if $(SIM) $(BUILD_DIR)/rv64um-p-$$test.bin --timeout 2000000 --tohost $$TOHOST > $(BUILD_DIR)/rv64um-p-$$test.log 2>&1; then \
				echo "PASS"; \
				passed=$$((passed + 1)); \
			else \
				echo "FAIL"; \
				failed=$$((failed + 1)); \
			fi; \
		else \
			echo "  $$test: SKIP (not found)"; \
			skipped=$$((skipped + 1)); \
		fi; \
	done; \
	echo ""; \
	echo "RV64UM Results: $$passed passed, $$failed failed, $$skipped skipped"; \
	test $$failed -eq 0 && test $$skipped -eq 0

clean:
	rm -rf $(BUILD_DIR)
